{
  "_comment": "Fixed visit record for an adult hypertension visit (WHO HEARTS 2018; WHO 2021 guideline). Codes only: labels live in locale packs. Value sets follow the gold-label conventions. follow_up uses ISO-8601 durations (P2W = 2 weeks). Admin fields are typed, never extracted.",
  "fields": {
    "patient_name":   {"kind": "text", "admin": true},
    "phone":          {"kind": "text", "admin": true, "optional": true},
    "visit_date":     {"kind": "date", "admin": true, "default": "today"},
    "sex":            {"kind": "enum", "values": ["F", "M", "unknown"]},
    "age":            {"kind": "int"},
    "bp1_sys":        {"kind": "int", "numeric_bp": true},
    "bp1_dia":        {"kind": "int", "numeric_bp": true},
    "bp2_sys":        {"kind": "int", "numeric_bp": true, "optional": true},
    "bp2_dia":        {"kind": "int", "numeric_bp": true, "optional": true},
    "headache":       {"kind": "enum", "values": ["present", "absent", "uncertain", "not_mentioned"]},
    "chest_pain":     {"kind": "enum", "values": ["present", "absent", "uncertain", "not_mentioned"]},
    "blurred_vision": {"kind": "enum", "values": ["present", "absent", "uncertain", "not_mentioned"]},
    "breathless":     {"kind": "enum", "values": ["present", "absent", "uncertain", "not_mentioned"]},
    "on_meds":        {"kind": "enum", "values": ["yes", "no", "not_mentioned"]},
    "missed_doses":   {"kind": "enum", "values": ["yes", "no", "sometimes", "na", "not_mentioned"]},
    "pregnancy":      {"kind": "enum", "values": ["pregnant", "not_pregnant", "na", "not_mentioned"]},
    "counselling":    {"kind": "enum", "values": ["yes", "no", "not_mentioned"]},
    "referral":       {"kind": "enum", "values": ["yes", "not_mentioned"]},
    "follow_up":      {"kind": "enum", "values": ["P3D", "P1W", "P2W", "P3W", "P1M", "P2M", "P3M", "P6M", "not_mentioned"]}
  }
}
